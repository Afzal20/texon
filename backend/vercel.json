{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.13",
        "maxLambdaSize": "15mb",
        "includeFiles": "templates/**,static/**"
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "api/index.py" }]
}